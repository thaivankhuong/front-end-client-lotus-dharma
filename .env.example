# LotusDharma Environment Configuration
# Copy this file to .env.local and fill in your actual values

# App Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=LotusDharma
NEXT_PUBLIC_APP_VERSION=1.0.0

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000
API_TIMEOUT=30000
API_RETRIES=3

# Authentication (REQUIRED - Generate secure random strings)
NEXT_PUBLIC_JWT_SECRET=your-super-secure-jwt-secret-at-least-32-characters-long-here
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Security (REQUIRED - Generate secure random strings)
CSRF_SECRET=your-super-secure-csrf-secret-at-least-32-characters-long-here
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# CDN & Assets (Optional)
# NEXT_PUBLIC_CDN_URL=https://cdn.lotusdharm.com
# NEXT_PUBLIC_IMAGE_DOMAIN=cdn.lotusdharm.com

# Monitoring (Optional)
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=info
# LOG_WEBHOOK_URL=https://your-logging-service.com/webhook

# Caching
CACHE_REVALIDATE_INTERVAL=3600
ISR_REVALIDATE_INTERVAL=86400

# Feature Flags
FEATURE_I18N=false
FEATURE_ANALYTICS=false
FEATURE_PWA=false

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# External Services (Optional)
# REDIS_URL=redis://localhost:6379
# DATABASE_URL=postgresql://user:pass@localhost:5432/db