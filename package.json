{
    "name": "lotus-dharma-fe",
    "version": "1.0.0",
    "description": "LotusDharma - Ứng dụng Phật giáo Next.js với khả năng mở rộng cao",
    "private": true,
    "scripts": {
        "dev": "next dev -p 3001",
        "build": "next build",
        "start": "next start -p 3001",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "type-check": "tsc --noEmit",
        "generate:types": "node scripts/generate-api-types.js",
        "generate:types:test": "node scripts/generate-api-types.js --test",
        "clean": "rm -rf .next out node_modules/.cache",
        "clean:next": "rm -rf .next",
        "test:phase2": "node scripts/test-phase2.js",
        "setup": "node scripts/setup-project.js",
        "setup:force": "npm install --legacy-peer-deps --force",
        "generate-secrets": "node scripts/generate-secrets.js",
        "debug-env": "node scripts/debug-env.js",
        "test-env": "node scripts/test-env-loading.js",
        "verify": "node verify-setup.js"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.17.15",
        "@turf/turf": "^7.3.0",
        "cheerio": "^1.0.0-rc.10",
        "clsx": "^2.1.0",
        "geojson": "^0.5.0",
        "isomorphic-dompurify": "^2.9.0",
        "leaflet": "^1.9.4",
        "lucide-react": "^0.554.0",
        "next": "15.1.6",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-leaflet": "^4.2.1",
        "tailwind-merge": "^2.2.1",
        "xml2js": "^0.6.2",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/geojson": "^7946.0.16",
        "@types/leaflet": "^1.9.21",
        "@types/node": "^20",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "dotenv": "^16.3.1",
        "eslint": "^8",
        "eslint-config-next": "15.1.6",
        "openapi-typescript": "^6.7.3",
        "tailwindcss": "^4",
        "typescript": "^5"
    }
}
