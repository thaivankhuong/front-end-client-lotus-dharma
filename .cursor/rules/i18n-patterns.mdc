### Missing Translation Detection
```typescript
// lib/i18n/utils.ts
export function detectMissingTranslations(locale: Locale): string[] {
  const defaultTranslations = require('./locales/vi.json');
  const localeTranslations = require(`./locales/${locale}.json`);

  const missing: string[] = [];

  function checkNested(obj: any, path = '') {
    for (const key in obj) {
      const fullPath = path ? `${path}.${key}` : key;

      if (typeof obj[key] === 'object') {
        checkNested(obj[key], fullPath);
      } else if (!localeTranslations[key]) {
        missing.push(fullPath);
      }
    }
  }

  checkNested(defaultTranslations);
  return missing;
}

// Usage in development
if (process.env.NODE_ENV === 'development') {
  const missing = detectMissingTranslations('en');
  if (missing.length > 0) {
    console.warn('Missing translations for en:', missing);
  }
}
```

## Performance Optimization

### Translation Loading Strategy
```typescript
// lib/i18n/client.ts
class TranslationLoader {
  private cache = new Map<string, any>();

  async loadTranslations(locale: string, namespaces: string[] = []) {
    const cacheKey = `${locale}:${namespaces.join(',')}`;

    if (this.cache.has(cacheKey)) {
      return this.cache.get(cacheKey);
    }

    const translations = {};

    for (const ns of ['common', ...namespaces]) {
      try {
        const module = await import(`./locales/${locale}/${ns}.json`);
        translations[ns] = module.default;
      } catch (error) {
        console.warn(`Failed to load ${locale}/${ns}.json`);
      }
    }

    this.cache.set(cacheKey, translations);
    return translations;
  }
}

export const translationLoader = new TranslationLoader();
```