### i18n Configuration
```typescript
// lib/i18n/config.ts
export const i18nConfig = {
  locales: ['vi', 'en'] as const,
  defaultLocale: 'vi',
  localeDetection: true,
  domains: [
    {
      domain: 'lotusdharma.com',
      defaultLocale: 'vi'
    },
    {
      domain: 'en.lotusdharma.com',
      defaultLocale: 'en'
    }
  ]
} as const;

export type Locale = typeof i18nConfig.locales[number];
```

### Translation Hook
```typescript
// lib/hooks/use-translation.ts
import { useRouter } from 'next/router';

export function useTranslation(namespace?: string) {
  const { locale, defaultLocale } = useRouter();

  return useMemo(() => {
    const loadTranslations = async (lang: string) => {
      try {
        const translations = await import(`../i18n/locales/${lang}.json`);
        return namespace ? translations[namespace] : translations;
      } catch (error) {
        console.warn(`Translation file not found for locale: ${lang}`);
        return {};
      }
    };

    return {
      t: (key: string, fallback?: string) => {
        const keys = key.split('.');
        let value = translations;

        for (const k of keys) {
          value = value?.[k];
        }

        return value || fallback || key;
      },
      locale,
      loadTranslations
    };
  }, [locale, namespace]);
}

// Usage
export function Navigation() {
  const { t } = useTranslation('nav');

  return (
    <nav>
      <Link href="/">{t('home')}</Link>
      <Link href="/teachings">{t('teachings')}</Link>
    </nav>
  );
}
```

## Internationalized Routing

### Route Structure for Multi-language
```
app/
├── (public)/
│   ├── [locale]/
│   │   ├── page.tsx          # /vi, /en
│   │   ├── teachings/
│   │   │   └── page.tsx      # /vi/teachings, /en/teachings
│   │   └── meditation/
│   │       └── page.tsx      # /vi/meditation, /en/meditation
│   └── page.tsx              # Redirect to /vi
├── (auth)/
│   └── [locale]/
│       ├── login/
│       │   └── page.tsx      # /vi/login, /en/login
│       └── dashboard/
│           └── page.tsx      # /vi/dashboard, /en/dashboard
```

### Locale-aware Components
```typescript
// components/ui/LocaleSwitcher.tsx
export function LocaleSwitcher() {
  const router = useRouter();
  const { locales, locale: currentLocale } = router;

  const switchLocale = (newLocale: string) => {
    const { pathname, query, asPath } = router;
    router.push({ pathname, query }, asPath, { locale: newLocale });
  };

  return (
    <select
      value={currentLocale}
      onChange={(e) => switchLocale(e.target.value)}
    >
      {locales?.map((locale) => (
        <option key={locale} value={locale}>
          {locale === 'vi' ? 'Tiếng Việt' : 'English'}
        </option>
      ))}
    </select>
  );
}
```

## Content Internationalization

### Dynamic Content Translation
```typescript
// lib/api/content.ts
export interface TranslatedContent {
  vi: string;
  en: string;
}

export async function getTranslatedTeaching(id: string, locale: Locale): Promise<Teaching> {
  const teaching = await db.teachings.findUnique({ where: { id } });

  if (!teaching) throw new NotFoundError('Teaching not found');

  return {
    id: teaching.id,
    title: teaching.translations[locale]?.title || teaching.translations.vi.title,
    content: teaching.translations[locale]?.content || teaching.translations.vi.content,
    author: teaching.author,
    createdAt: teaching.createdAt
  };
}

// API route with locale support
// app/api/[locale]/teachings/[id]/route.ts
export async function GET(
  request: NextRequest,
  { params }: { params: { locale: string; id: string } }
) {
  const { locale, id } = params;

  if (!i18nConfig.locales.includes(locale as Locale)) {
    return NextResponse.json({ error: 'Invalid locale' }, { status: 400 });
  }

  try {
    const teaching = await getTranslatedTeaching(id, locale as Locale);
    return NextResponse.json(teaching);
  } catch (error) {
    return NextResponse.json({ error: 'Teaching not found' }, { status: 404 });
  }
}
```

### SEO & Metadata i18n

### Localized Metadata
```typescript
// app/[locale]/teachings/[slug]/page.tsx
export async function generateMetadata({ params }: { params: { locale: string; slug: string } }) {
  const { locale, slug } = params;
  const teaching = await getTranslatedTeaching(slug, locale as Locale);

  return {
    title: teaching.title,
    description: teaching.excerpt,
    alternates: {
      canonical: `/${locale}/teachings/${slug}`,
      languages: {
        vi: `/vi/teachings/${slug}`,
        en: `/en/teachings/${slug}`
      }
    },
    openGraph: {
      title: teaching.title,
      description: teaching.excerpt,
      locale: locale,
      alternateLocale: locale === 'vi' ? 'en' : 'vi'
    }
  };
}
```

